# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# MongoDB Atlas connection. Replace <db_user> and <db_password> with your own.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.ppie0nu.mongodb.net/
MONGODB_DB=trade

# Enables the three fictional roles for team testing.
DEMO_ENABLED=true

# Stores images in MongoDB when R2 is unavailable (5 MB maximum per image).
MONGODB_FILES=true
