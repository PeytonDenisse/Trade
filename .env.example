# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# Database: Cloudflare D1 (SQLite). There is no connection string.
# The database is injected as the `DB` binding (see .openai/hosting.json and db/index.ts).
# Locally it lives in .wrangler/state; tables are defined in db/schema.ts.

# Enables the "Recorrido de demo" fake identities. Keep false unless demoing.
DEMO_ENABLED=false
